# --- Claim decision letter email (Gmail SMTP) ---
# 1) Google Account → Security → enable 2-Step Verification
# 2) Create an App Password for Mail
# 3) Copy this file to .env and fill in your values (never commit .env)

EMAIL_ENABLED=true
EMAIL_NOTIFY_TO=you@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# Replace with your 16-character Gmail App Password (spaces optional)
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM=you@example.com
